# Copy this file to secrets.toml (same folder) and put your real API keys
# THERE — the backend reads only secrets.toml, never this .example file.
# Never commit secrets.toml to git (it is gitignored); never put real keys here.

GEMINI_API_KEY = "your-gemini-api-key-here"
GROQ_API_KEY = "your-groq-api-key-here"

# Optional: override the models if a provider retires the default ones.
# GROQ_MODEL = "openai/gpt-oss-120b"
# GEMINI_MODEL = "gemini-2.5-flash-lite"
