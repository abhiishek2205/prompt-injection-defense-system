# Secrets
# Scoped to the actual secret files — a blanket *.toml would also swallow
# pyproject.toml, railway config and anything else the project needs tracked.
.streamlit/secrets.toml
backend/.streamlit/secrets.toml
.env
.env.local
.env.development
# NOTE: frontend/.env.production is intentionally tracked — it holds only the
# public API URL that the Vercel build needs, not a secret.

